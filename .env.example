# ===== 应用 =====
APP_ENV=dev
APP_API_KEY=dev-api-key-change-me
LOG_LEVEL=INFO
# 生产务必 false：禁止 InMemory 向量库 / 本地 blob 兜底
ALLOW_INMEMORY_FALLBACK=false
# 生产必须 false，并通过 Alembic 运行迁移
AUTO_CREATE_SCHEMA=false
API_KEY_PEPPER=replace-with-a-long-random-secret
LEGACY_TENANT_ID=legacy
LEGACY_KNOWLEDGE_BASE_ID=legacy-default

# ===== Postgres =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# ===== Redis（限流 / 缓存，不做任务队列）=====
REDIS_URL=redis://localhost:6379/0

# ===== RabbitMQ（RAG 异步流水线）=====
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-docs
MINIO_SECURE=false

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks
MILVUS_DIM=1536
MILVUS_COLLECTION_V2=kb_chunks_v2

# ===== RAG 生产控制 =====
RAG_MAX_UPLOAD_BYTES=26214400
RAG_MAX_PDF_PAGES=300
RAG_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
RAG_MAX_DOCX_COMPRESSION_RATIO=100
RAG_PARSER_TIMEOUT_SECONDS=90
RAG_STAGE_LEASE_SECONDS=300
RAG_OUTBOX_BATCH_SIZE=100
RAG_RELEVANCE_THRESHOLD=0.35
RAG_USE_QUERY_EXPANSION=false
OPENSEARCH_URL=
OPENSEARCH_INDEX=kb_chunks_v2
RERANKER_URL=

# ===== LLM（业务侧：只连 LiteLLM Proxy）=====
# 这里不要填 OpenAI/Anthropic 真 key。
# 真 key 只写在 deploy/litellm/.env
# Compose 内 LLM_BASE_URL 会覆盖为 http://litellm:4000
LLM_BASE_URL=http://localhost:4000
# Proxy 的访问 sk，须与 deploy/litellm/.env 里 LITELLM_MASTER_KEY 相同
LLM_API_KEY=sk-litellm-master
# 模型名 = Proxy config.yaml 里的 model_name
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LLM_FALLBACK_CHAT_MODEL=gpt-4o-mini

# ===== 网关策略 =====
GATEWAY_RPM=60
GATEWAY_TPM=100000
GATEWAY_CIRCUIT_FAIL_THRESHOLD=5
GATEWAY_CIRCUIT_RESET_SECONDS=30
EMBED_BATCH_SIZE=32
RAG_MAX_RETRIES=3
RAG_RERANK_MODE=llm

# ===== Agent =====
AGENT_DEFAULT_STRATEGY=react
AGENT_MAX_ITERATIONS=8
AGENT_ENABLE_HITL=false
AGENT_ENABLE_CHECKPOINT=true
# MCP servers JSON 数组；空则只用内置工具
MCP_SERVERS_JSON=[]
# 项目级 Skills 目录（相对仓库根或绝对路径）
SKILLS_DIR=skills
# http_get 允许主机（逗号分隔）；空=开发不限制
ALLOWED_HTTP_HOSTS=

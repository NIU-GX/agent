# ===== 应用 =====
APP_ENV=dev
APP_API_KEY=dev-api-key-change-me
LOG_LEVEL=INFO
# 生产务必 false：禁止 InMemory 向量库 / 本地 blob 兜底
ALLOW_INMEMORY_FALLBACK=false

# ===== Postgres =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# ===== Redis（限流 / 缓存，不做任务队列）=====
REDIS_URL=redis://localhost:6379/0

# ===== RabbitMQ（RAG 异步流水线）=====
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-docs
MINIO_SECURE=false

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks
MILVUS_DIM=1536

# ===== LLM（OpenAI-compatible；可选 LiteLLM 模型名）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LLM_FALLBACK_CHAT_MODEL=gpt-4o-mini
# 非空则走 LiteLLM，例如 openai/gpt-4o-mini
LITELLM_MODEL=
LITELLM_FALLBACK_MODEL=

# ===== 网关策略 =====
GATEWAY_RPM=60
GATEWAY_TPM=100000
GATEWAY_CIRCUIT_FAIL_THRESHOLD=5
GATEWAY_CIRCUIT_RESET_SECONDS=30
EMBED_BATCH_SIZE=32
RAG_MAX_RETRIES=3
RAG_RERANK_MODE=llm

# ===== Agent =====
AGENT_DEFAULT_STRATEGY=react
AGENT_MAX_ITERATIONS=8
AGENT_ENABLE_HITL=false
AGENT_ENABLE_CHECKPOINT=true
# MCP servers JSON 数组；空则只用内置工具
MCP_SERVERS_JSON=[]
# 项目级 Skills 目录（相对仓库根或绝对路径）
SKILLS_DIR=skills
# http_get 允许主机（逗号分隔）；空=开发不限制
ALLOWED_HTTP_HOSTS=

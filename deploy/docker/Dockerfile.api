FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY packages/shared /app/packages/shared
COPY packages/llm-gateway /app/packages/llm-gateway
COPY packages/rag /app/packages/rag
COPY packages/agent-core /app/packages/agent-core
COPY packages/eval /app/packages/eval
COPY apps/api /app/apps/api

RUN pip install --no-cache-dir \
  /app/packages/shared \
  /app/packages/llm-gateway \
  /app/packages/rag \
  /app/packages/agent-core \
  /app/packages/eval \
  /app/apps/api

ENV PYTHONPATH=/app/apps/api
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

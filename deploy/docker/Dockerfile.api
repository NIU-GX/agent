FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY backend/packages/shared /app/backend/packages/shared
COPY backend/packages/llm-gateway /app/backend/packages/llm-gateway
COPY backend/packages/rag /app/backend/packages/rag
COPY backend/packages/agent-core /app/backend/packages/agent-core
COPY backend/packages/eval /app/backend/packages/eval
COPY backend/apps/api /app/backend/apps/api
COPY skills /app/skills

RUN pip install --no-cache-dir \
  /app/backend/packages/shared \
  /app/backend/packages/llm-gateway \
  /app/backend/packages/rag \
  /app/backend/packages/agent-core \
  /app/backend/packages/eval \
  /app/backend/apps/api

ENV PYTHONPATH=/app/backend/apps/api
ENV SKILLS_DIR=/app/skills
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
